#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/pointing.h>

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "go60_key_groups.h"

// layers
#define LAYER_Base 0
#define LAYER_Symbol 1
#define LAYER_Navi 2
#define LAYER_Magic 3
#define LAYER_LOL 4

#include "go60_macros.dtsi"
#include "go60_behaviors.dtsi"

/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        underscore_combo {
            timeout-ms = <81>;
            key-positions = <54 59>;
            bindings = <&kp UNDER>;
          };

        navigation_combo {
            timeout-ms = <2000>;
            key-positions = <55 58>;
            bindings = <&navi_layer_rgb>;
          };
        };

    keymap {
        compatible = "zmk,keymap";
        layer_Base {
            bindings = <
            &kp C_BRI_DN  &kp C_BRI_UP  &none   &kp GRAVE    &kp C_PREV   &kp C_PP                                      &kp C_PP    &kp C_NEXT &kp MINUS   &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP
              &kp TAB   &kp Q      &kp W    &kp E     &kp R   &kp T                                                       &kp Y     &kp U      &kp I     &kp O     &kp P            &kp TAB
              &kp ESC   &HRM_LPinky LALT A &HRM_LRing LCTRL S &HRM_LMiddle LGUI D &HRM_LIndex LSHFT F   &kp G            &kp H     &HRM_RIndex RSHFT J   &HRM_RMiddle RGUI K     &HRM_RRing RCTRL L  &HRM_RPinky RALT SEMI  &kp SQT
              &kp CAPS   &kp Z      &kp X    &kp C     &kp V   &kp B                                                       &kp N     &kp M  &kp COMMA   &kp DOT  &kp FSLH             &caps_word

                            &magic LAYER_Magic 0 &kp LEFT  &kp RIGHT                                                        &kp DOWN   &kp UP  &rgb_ug RGB_TOG

                                                           &kp BSPC  &lt_sym_rgb 0 RET  &kp DEL                      &kp BSPC  &lt_sym_rgb 0 RET  &kp SPACE 
            >;
        };

        layer_Symbol {
            bindings = <
            &trans &trans &trans &kp LS(GRAVE) &trans &trans                                                                    &trans &trans &kp LS(MINUS) &trans &trans &trans
            &kp CARET  &kp N1     &kp N2   &kp N3    &kp N4  &kp N5                                                      &kp N6    &kp N7     &kp N8    &kp N9    &kp N0           &kp DLLR
              &kp SQT   &kp STAR   &kp LBKT    &kp RBKT     &kp PLUS   &kp AT                                               &kp HASH     &kp EQUAL      &kp LPAR     &kp RPAR  &kp LS(SEMI)   &kp LS(SQT)
              &none   &kp EXCL    &kp LBRC    &kp RBRC     &kp PRCNT   &kp BSLH                                             &kp PIPE     &kp AMPS  &kp LS(COMMA)   &kp LS(DOT)  &kp LS(FSLH)     &none
 
                                &none   &none  &none                                                                      &none  &none  &none

                                                           &kp BSPC  &none  &kp DEL                     &kp BSPC  &none  &kp SPACE 
            >;
        };

        layer_Navi {
            bindings = <
            &trans &trans &trans &trans &trans &trans                                                                    &trans &trans &trans &trans &trans &trans
            &none  &none  &msc MOVE_Y(30)  &cmd_mb1  &none  &none                                                                       &none  &none  &shift_mb1  &msc MOVE_Y(-30) &none  &none
            &msc MOVE_X(-10)  &msc MOVE_Y(10)  &mkp MB1   &mmv MOVE_X(-550)  &mmv MOVE_X(500)  &none                                        &none  &mmv MOVE_Y(500)  &mmv MOVE_Y(-550)  &mkp MB2 &msc MOVE_Y(-10)  &msc MOVE_X(10)
            &none &none &mkp MB1 &mmv MOVE_X(-1090)  &mmv MOVE_X(1200) &none                                                  &none  &mmv MOVE_Y(1200)  &mmv MOVE_Y(-1090)  &mkp MB2 &none &lol_layer_rgb
 
                                &none   &none  &none                                                                      &none  &none  &none

                                                           &none   &none  &none                     &none  &none  &none
            >;
        };

        layer_Magic {
            bindings = <
            &trans &trans &trans &trans &trans &trans                                                                                           &trans &trans &trans &trans &trans &trans
           &bootloader  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                     &none         &none         &none   &none   &none       &bootloader
            &sys_reset  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                     &none         &none         &none   &none   &none        &sys_reset
                 &out OUT_USB     &none            &bt_0            &bt_1            &bt_2            &bt_3                                     &none         &none         &none   &none   &none         &none 
                                  &none            &none             &bt BT_CLR_ALL                                                                    &none         &none   &none

                                                                              &none   &none   &none           &none   &none   &none
            >;
        };

        layer_LOL {
            bindings = <
            &trans          &trans     &trans   &kp GRAVE   &trans   &trans                                                        &trans    &trans          &trans   &trans   &trans   &trans
            &kp ESC         &kp Q    &kp W    &kp E    &kp R    &tap_space                                                        &none     &none           &none    &none    &none    &none
            &ht_lol_bp TAB ESC       &kp A    &kp S    &kp D    &kp F    &kp G                                                    &none     &none           &none    &none    &none    &none
            &kp  M      &kp Z    &kp X    &kp C    &kp V    &ht_lol_bp P B                                                    &none     &none           &none    &none    &none    &none

                                     &kp Y  &kp U    &kp I                                                                   &none  &none  &none

                                                          &tap_space &kp LALT &kp N                                                &none  &lol_layer_off_enter  &lol_layer_off
            >;
        };
    };
};

&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

&cirque_lh_listener {
    input-processors = <&zip_xy_to_scroll_mapper>, <&zip_xy_scaler 1 16>, <&zip_click_to_right_click_mapper>;
};
